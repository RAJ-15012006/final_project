# ── Required ──────────────────────────────────────────────────────────────────
# Get your FREE Groq API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Change the model (default: llama-3.3-70b-versatile)
# Other options: llama3-8b-8192 (faster) | mixtral-8x7b-32768
# GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB connection (for production database integration)
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
